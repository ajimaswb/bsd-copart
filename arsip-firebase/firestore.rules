rules_version = '2';
// Monitoring Copart BSD: Firestore rules.
// Akses ditentukan oleh dokumen members/{email} dengan field role: admin | editor | viewer.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function memberPath() {
      return /databases/$(database)/documents/members/$(myEmail());
    }
    function isMember() {
      return signedIn() && exists(memberPath());
    }
    function role() {
      return get(memberPath()).data.role;
    }
    function canEdit() {
      return isMember() && role() in ['admin', 'editor'];
    }
    function isAdmin() {
      return isMember() && role() == 'admin';
    }

    match /copart/{copartId} {
      allow read: if isMember();
      allow create, update: if canEdit()
        && request.resource.data.nama is string
        && request.resource.data.nama.size() > 0
        && request.resource.data.nama.size() <= 200;
      allow delete: if canEdit();
    }

    match /members/{email} {
      allow read: if signedIn() && (email == myEmail() || isMember());
      allow create, update: if isAdmin()
        && email == email.lower()
        && request.resource.data.role in ['admin', 'editor', 'viewer'];
      allow delete: if isAdmin() && email != myEmail();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
